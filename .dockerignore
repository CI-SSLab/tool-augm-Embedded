# Secrets — never bake into the image
.env

# Git internals
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Evaluation output files (large, not needed at build time)
evaluation/results/
evaluation/evaluation/
evaluation/*.csv
evaluation/*.json

# Extension: notes, logs, cached images and evaluation outputs (not needed at runtime;
# the image keeps data/index/ and data/census/, which the image search reads)
info/
logs/
data/index_images/
data/demo/photos/
eval/**/results/
eval/regression/

# Docs
README.md
