# ── Europeana REST API ────────────────────────────────────────────────────────
# Request your key at https://api.europeana.eu/en
EUROPEANA_API_KEY=

# ── Ollama ────────────────────────────────────────────────────────────────────
# When running via docker compose this is set automatically to the ollama
# container. For a local Ollama use e.g. http://localhost:11434
# OLLAMA_BASE_URL=http://ollama:11434

# Model name as Ollama knows it (must be pulled first). Do not add "openai/":
# the agent adds the prefix itself, and "openai/gpt-oss:20b" gives a 404.
OLLAMA_MODEL=gpt-oss:20b

# Only required when using Ollama Cloud (leave unset for a local Ollama)
OLLAMA_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Exposed port for the Streamlit UI (default: 8501)
# APP_PORT=8501

# Interface and answer language: it (paper default) or en
UI_LANG=it

# ── Extensions (all flags false = paper baseline, unchanged) ──────────────────
# Image query path: photo + question -> embedding index -> Europeana/ICCD record
ENABLE_IMAGE_SEARCH=false
# Text cascade stage 4: ICCD/ArCo underwater sites when stages 1-3 return < 2 results
ENABLE_ICCD_FALLBACK=false

# Object group and index (data/census/<group>.csv, data/index/...):
#   curated_group     underwater group, catalogue photos only (default)
#   curated_group_uw  same group + underwater reference photos
#   famous_group      famous artworks of the paper's artists (generality test)
IMAGE_GROUP=curated_group

# Image encoder (plan B / baseline: google/siglip2-base-patch16-224)
IMAGE_ENCODER=google/embeddinggemma-2
# Device for embeddings: cuda:0 (bf16 on Ampere or newer, fp32 otherwise) or cpu (fp32). Never fp16.
EMBED_DEVICE=cuda:0
# Colour correction of the query photo: none | grayworld | clahe
IMAGE_COLOUR=none

# ArCo SPARQL endpoint (CNR mirror: http://wit.istc.cnr.it/arco/virtuoso/sparql)
ARCO_SPARQL_URL=http://dati.beniculturali.it/sparql
